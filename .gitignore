.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Secrets
.env
.env.*
!.env.example
*.kubeconfig

# Logs
*.log

# Go build outputs and test artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
